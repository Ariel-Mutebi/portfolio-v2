<style is:global>
  /*
    Each keyframe flips one quadrant of every 2×2 pixel block.
    conic-gradient runs clockwise from 12 o'clock, so the four
    stops map to: TR (0–90deg), BR (90–180), BL (180–270), TL (270–360).
  */
  @keyframes pixel-flip {
    0% {
      mask-image: conic-gradient(
        transparent 0deg 90deg,
        transparent 90deg 180deg,
        transparent 180deg 270deg,
        #000 270deg 360deg
      );
    }
    25% {
      mask-image: conic-gradient(
        transparent 0deg 90deg,
        #000 90deg 180deg,
        transparent 180deg 270deg,
        #000 270deg 360deg
      );
    }
    50% {
      mask-image: conic-gradient(
        #000 0deg 90deg,
        #000 90deg 180deg,
        transparent 180deg 270deg,
        #000 270deg 360deg
      );
    }
    75%,
    100% {
      mask-image: conic-gradient(
        #000 0deg 90deg,
        #000 90deg 180deg,
        #000 180deg 270deg,
        #000 270deg 360deg
      );
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Old page stays completely static underneath */
    html::view-transition-old(root) {
      animation: none !important;
      z-index: -1;
    }

    /* New page is revealed through a grid of large pixel cells.
       steps(1, end) makes each keyframe hard-cut instead of fade. */
    html::view-transition-new(root) {
      mask-image: conic-gradient(
        #000 0deg 90deg,
        #000 90deg 180deg,
        #000 180deg 270deg,
        #000 270deg 360deg
      );
      mask-size: 160px 160px; /* 2×2 block of 80px pixels */
      mask-repeat: repeat;
      mask-position: top left;
      animation: pixel-flip 600ms steps(1, end) both !important;
    }
  }
</style>
