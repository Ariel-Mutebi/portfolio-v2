---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  label: string;
}

const { label, class: className, type = "button", ...attrs } = Astro.props;

const bracket =
  "inline-block transition-transform duration-300 ease-out motion-reduce:transition-none";
---

<button
  type={type}
  aria-label={label}
  class:list={["group inline-flex p-2 font-mono", className]}
  {...attrs}
>
  <span
    aria-hidden="true"
    class:list={[bracket, "group-hover:-translate-x-1 group-focus-visible:-translate-x-1"]}
  >[</span>
  <span
    aria-hidden="true"
    class="transition-[letter-spacing,margin] duration-300 ease-out
      group-hover:mr-[-0.15em] group-hover:tracking-[0.15em] group-focus-visible:mr-[-0.15em]
      group-focus-visible:tracking-[0.15em] motion-reduce:transition-none"
  >{label}</span>
  <span
    aria-hidden="true"
    class:list={[bracket, "group-hover:translate-x-1 group-focus-visible:translate-x-1"]}
  >]</span>
</button>
