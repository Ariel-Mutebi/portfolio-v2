---
import menu from "../../content/menu.json";
import Button from "./Button.astro";

const { links } = menu;
---

<Button
  label="MENU"
  id="open-menu"
  aria-haspopup="dialog"
  class="fixed z-40 top-6 right-6 text-ebony-400 mix-blend-difference"
/>

<dialog
  id="menu"
  aria-label="Site menu"
  class:list={[
    /** Panel */
    "fixed inset-y-0 right-0 left-auto z-50 w-[80dvw] max-w-150 h-dvh max-h-none bg-steel-200",
    /** Slide */
    "translate-x-full open:translate-x-0 starting:open:translate-x-full data-closing:translate-x-full",
    "transition-[translate] duration-200 ease-[ease] motion-reduce:transition-none",
    /** Backdrop blur */
    "backdrop:bg-transparent backdrop:backdrop-blur-xs",
    "starting:open:backdrop:backdrop-blur-[0px] data-closing:backdrop:backdrop-blur-[0px]",
    "backdrop:transition-[backdrop-filter] backdrop:duration-200 motion-reduce:backdrop:transition-none",
  ]}
>
  <nav class="py-10 px-5 md:px-10">
    <Button
      label="CLOSE"
      id="close-menu"
      class="text-chilli-900 mb-5 md:mb-10"
    />
    <ul class="flex flex-col gap-5 md:gap-10">
      {links.map(({ href, label }) => (
        <li>
          <a
            class="relative inline-block font-mono text-viridian-900 text-4xl md:text-6xl
              after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-current
              after:origin-left after:scale-x-0 after:transition-transform after:duration-300
              hover:after:scale-x-100 focus-visible:after:scale-x-100 motion-reduce:after:transition-none"
            {href}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</dialog>

<script>
  function main() {
    const menu = document.getElementById("menu") as HTMLDialogElement;
    const trigger = document.getElementById("open-menu") as HTMLButtonElement;

    /** Slides the menu out, then closes it. */
    async function closeMenu() {
      menu.toggleAttribute("data-closing", true);
      await Promise.allSettled(
        menu.getAnimations().map((animation) => animation.finished),
      );
      menu.close();
      menu.removeAttribute("data-closing");
    }

    trigger.addEventListener("click", () => menu.showModal());

    /** Close on a backdrop click or when a link is chosen. */
    menu.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === menu || target.closest("a")) closeMenu();
    });

    /** Esc: replace the instant close with the animated one. */
    menu.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeMenu();
    });

    document.getElementById("close-menu")!.addEventListener("click", closeMenu);
  }

  document.addEventListener("astro:page-load", main);
</script>
