---
import { Image } from "astro:assets";
import me from "../../assets/me.jpg";
import holder from "../../assets/holder.svg";
import styles from "./Dossier.module.css";
import type { SkillSet } from "./types.ts";
import Pill from "./Pill.astro";

interface Props {
  skillSets: SkillSet[];
}

const { skillSets } = Astro.props;
---

<div data-dossier class:list={["min-h-dvh p-5 sm:p-10", styles.backdrop]}>
  <div class="w-full lg:max-w-250 aspect-3/2 lg:mx-auto grid lg:grid-cols-2 perspective-[1800px]">
    <aside
      data-page
      class:list={[
        "p-5 origin-right transform-3d will-change-transform",
        styles.pageLeft,
      ]}
    >
      <figure
        class:list={[
          "grid grid-cols-(--img) p-4 gap-3 w-fit border border-ebony-200",
          "bg-linear-to-l from-ebony-50 to-ebony-100 hover:shadow",
          styles.figure,
        ]}
      >
        <div class="relative w-full aspect-3/4">
          <Image
            src={me}
            alt="Man wearing hard hat posing at a construction site"
            format="webp"
            class="w-full h-full object-cover"
          />
          <div
            class:list={[
              "absolute inset-0 pointer-events-none",
              styles.photoShade,
            ]}
          ></div>
        </div>

        <figcaption class="text-xs text-ebony-600">
          Me visiting the construction site of a disaster-recovery data centre
        </figcaption>
      </figure>
    </aside>

    <div class:list={["relative lg:p-4 grid items-end", styles.pageRight]}>
      <Image
        src={holder}
        alt=""
        format="svg"
        class="hidden lg:block absolute bottom-0 inset-x-0 w-full z-10"
      />
      <article
        class="flex flex-col gap-8 lg:aspect-3/4 hover:lg:-translate-y-2 border border-ebony-200
          bg-linear-to-l from-ebony-50 to-ebony-100 p-6 lg:pb-20"
      >
        <hgroup class="grid gap-1">
          <h2 class="font-light text-3xl text-ebony-800 underline">
            Specification Sheet
          </h2>
          <p class="font-light text-xs text-ebony-600">
            Click on a skill to see where I've used it.
          </p>
        </hgroup>

        <section class="grid grid-cols-[1fr_4fr] gap-6">
          {skillSets.map(({ skillSet, skills }) => (
            <>
              <h3 class="font-mono font-bold text-ebony-500 text-sm">
                {skillSet}
              </h3>
              <div class="flex flex-wrap items-start gap-x-3 gap-y-2">
                {skills.map((skill) => (
                  <Pill {...skill} />
                ))}
              </div>
            </>
          ))}
        </section>
      </article>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo(
    "[data-page]",
    { rotateY: 80 },
    {
      rotateY: 0,
      ease: "none",
      scrollTrigger: {
        trigger: "[data-dossier]",
        start: "top bottom",
        end: "top 20%",
        scrub: true,
      },
    },
  );
</script>
