---
import { Image } from "astro:assets";
import me from "../../assets/me.jpg";
import holder from "../../assets/holder.svg";
import styles from "./Dossier.module.css";
import type { SkillSet } from "./types.ts";

interface Props {
  skillSets: SkillSet[];
}

const { skillSets } = Astro.props;
---

<div data-dossier class:list={["h-dvh p-10", styles.backdrop]}>
  <div class="md:w-[min(100%,calc((100dvh-5rem)*3/2))] md:aspect-3/2 md:mx-auto grid md:grid-cols-2 perspective-[1800px]">
    <aside
      data-page
      class:list={[
        "w-full p-5 md:aspect-3/4 origin-right transform-3d will-change-transform",
        styles.pageLeft,
      ]}
    >
      <figure
        class:list={[
          "grid grid-cols-(--img) p-4 gap-3 w-fit border border-ebony-200 bg-linear-to-l from-ebony-50 to-ebony-100",
          styles.figure,
        ]}
      >
        <div class="relative w-full md:aspect-3/4">
          <Image
            src={me}
            alt="Man wearing hard hat posing at a construction site"
            format="webp"
            class="w-full h-full object-cover"
          />
          <div
            class:list={[
              "absolute inset-0 pointer-events-none",
              styles.photoShade,
            ]}
          ></div>
        </div>

        <figcaption class="text-sm text-ebony-600">
          Me visiting the construction site of a disaster-recovery data centre
        </figcaption>
      </figure>
    </aside>
    <article class:list={["w-full aspect-3/4 relative", styles.pageRight]}>
      <Image src={holder} alt="" format="svg" class="hidden md:block absolute bottom-0 inset-x-0 w-full" />
    </article>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo(
    "[data-page]",
    { rotateY: 80 },
    {
      rotateY: 0,
      ease: "none",
      scrollTrigger: {
        trigger: "[data-dossier]",
        start: "top bottom",
        end: "top 20%",
        scrub: true,
      },
    },
  );
</script>
