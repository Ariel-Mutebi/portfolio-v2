---
import type { Skill } from "./types.ts";

type Props = Skill;
const { name, level, link } = Astro.props;

interface Scheme {
  border: string;
  dot: string;
  text: string;
}

const colors: Record<number, Scheme> = {
  0: {
    border: "border-steel-600",
    dot: "bg-steel-300",
    text: "text-steel-950",
  },
  1: {
    border: "border-pollen-600",
    dot: "bg-pollen-300",
    text: "text-pollen-950",
  },
  2: {
    border: "border-viridian-500",
    dot: "bg-viridian-300",
    text: "text-viridian-800",
  },
};
---

<a
  href={link}
  class:list={[
    "flex items-center border rounded-md gap-1 px-1 py-0.5",
    "hover:-translate-y-0.5 hover:scale-105 hover:shadow",
    colors[level]["border"],
  ]}
>
  <div
    class:list={[
      "size-2 border",
      colors[level]["dot"],
      colors[level]["border"],
    ]}
  ></div>
  <p class:list={["font-mono font-medium text-[10px]", colors[level]["text"]]}>
    {name}
  </p>
</a>
