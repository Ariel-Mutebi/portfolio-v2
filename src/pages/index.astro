---
import BaseHead from "../components/BaseHead.astro";
import Hero from "../components/hero/Hero.svelte";
import page from "../content/index.json";
import terrain from "../data/terrain.json";
import heightmapUrl from "../assets/terrain/heightmap.bin?url";
import watermaskUrl from "../assets/terrain/watermask.bin?url";
import normalmapUrl from "../assets/terrain/normalmap.bin?url";
import shadowmapUrl from "../assets/terrain/shadowmap.bin?url";
import noisemapUrl from "../assets/terrain/noise.bin?url";
import Statement from "../components/statement/Statement.svelte";
import Skills from "../components/skills/Skills.svelte";
import legoUrl from "../assets/3031.mpd?url";

const { hero, statement, files } = page;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${hero.name} | Home`} description={hero.titles} />
	</head>
	<body class="font-sans bg-ebony-50 cursor-default">
		<Hero
			{...hero}
			{terrain}
			{heightmapUrl}
			{watermaskUrl}
			{normalmapUrl}
			{shadowmapUrl}
			{noisemapUrl}
			client:load
		/>
		<Statement {statement} client:visible />
		<Skills {files} {legoUrl} client:visible />
	</body>
</html>
